PORT=4000

# PostgreSQL connection string, e.g.:
#   postgresql://user:password@localhost:5432/springvalley
# For a hosted database (Neon, Supabase, Render Postgres, etc.) use the
# connection string they give you.
DATABASE_URL=postgresql://springvalley:springvalley@localhost:5432/springvalley

# Most hosted Postgres providers require SSL. Set to "false" only for a
# local database that has no SSL configured.
DATABASE_SSL=true
